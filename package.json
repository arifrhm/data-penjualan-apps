{
  "name": "data-penjualan-monorepo",
  "private": true,
  "scripts": {
    "dev:api": "pnpm --filter api dev",
    "dev:web": "pnpm --filter web dev",
    "dev": "pnpm --parallel --filter api --filter web dev",
    "build:shared": "pnpm --filter @sales-app/shared build",
    "build:api": "pnpm --filter api build",
    "build:web": "pnpm --filter web build",
    "build": "pnpm --filter @sales-app/shared build && pnpm --parallel --filter api --filter web build",
    "seed": "pnpm --filter api seed",
    "test:api": "pnpm --filter api test",
    "test": "pnpm --filter api test",
    "test:changed": "pnpm --filter api test --changed",
    "test:e2e": "pnpm --filter e2e test",
    "test:ci-local": "./scripts/run-local-ci.sh"
  },
  "devDependencies": {
    "typescript": "^5.3.3"
  }
}
